# ---------- AI model weights & runtime artifacts ----------
# Model binaries are large and trained externally; re-copy from the source
# "AI apps" projects if missing. Runtime uploads/results are generated data.
app/static/ai_models/*.pt
app/static/ai_models/*.keras
app/static/ai_models/*.h5
app/static/ai_models/uploads/
app/static/ai_models/results/

# ---------- Standalone reference source projects (not part of iHIS repo) ----------
# The original AI apps live in "AI apps/" and contain their own git history,
# large model files, and secrets. They are integrated into iHIS, not versioned here.
AI apps/

