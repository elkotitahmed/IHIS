# ---- iHIS environment variables ----
# Copy this file to `.env` (or set these as real environment variables on the
# deployment host) and replace every value with your own. Never commit `.env`.

# Flask runtime secret. REQUIRED in production - use a long random string:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Configuration profile: development | production | testing
# Defaults to 'development' when unset.
FLASK_CONFIG=production

# Database connection string. SQLite is fine for local development:
#   sqlite:///database/ihis.db
# For production use a managed database, e.g. PostgreSQL:
#   postgresql+psycopg2://USER:PASSWORD@HOST:5432/ihis
DATABASE_URL=sqlite:///database/ihis.db

# --- Optional overrides (comment/uncomment as needed) ---
# Upload folder (defaults to app/static/uploads)
# UPLOAD_FOLDER=app/static/uploads

# Session lifetime in days (default 1)
# PERMANENT_SESSION_LIFETIME_DAYS=1

# Remember-me cookie duration in days (default 7)
# REMEMBER_COOKIE_DURATION_DAYS=7

# Server host / port used by dev runner
# HOST=0.0.0.0
# PORT=5000